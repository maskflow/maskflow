{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the MaskFlow Gateway /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "MaskFlow evidence: what was masked, from gateway Prometheus metrics. Panels only -- no compliance-control framing (pending issue #42).",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "row",
      "title": "Evidence emission",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10
    },
    {
      "type": "stat",
      "title": "Evidence events emitted (5m rate)",
      "description": "maskflow_evidence_emitted_total -- zero unless [evidence] is enabled on the gateway.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 11,
      "targets": [
        { "expr": "sum(rate(maskflow_evidence_emitted_total[5m]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Evidence events by sink",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 1 },
      "id": 12,
      "targets": [
        {
          "expr": "sum by (sink) (rate(maskflow_evidence_emitted_total[5m]))",
          "legendFormat": "{{sink}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "What was masked",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 20
    },
    {
      "type": "timeseries",
      "title": "Detections by entity type (request side, 5m rate)",
      "description": "maskflow_detections_total{direction=\"request\"} -- PII masked before it reached the provider.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 21,
      "targets": [
        {
          "expr": "sum by (entity_type) (rate(maskflow_detections_total{direction=\"request\"}[5m]))",
          "legendFormat": "{{entity_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Detection mix by entity type (last 24h)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 22,
      "targets": [
        {
          "expr": "sum by (entity_type) (increase(maskflow_detections_total[24h]))",
          "legendFormat": "{{entity_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mask stage latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 30,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(maskflow_stage_latency_seconds_bucket{stage=\"mask\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(maskflow_stage_latency_seconds_bucket{stage=\"mask\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(maskflow_stage_latency_seconds_bucket{stage=\"mask\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ],
  "schemaVersion": 39,
  "tags": ["maskflow", "evidence", "pii"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "MaskFlow Evidence",
  "uid": "maskflow-evidence",
  "version": 1
}
